# zdxsv as a systemd service: one process (`zdxsv`, no command) serving dns, dnas,
# lobby and battle. Install: see docs/DEPLOY.md.
#
#   sudo cp infra/systemd/zdxsv.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zdxsv
#   journalctl -u zdxsv -f
#
# Paths:
#   /opt/zdxsv/bin/zdxsv     a symlink into /opt/zdxsv/releases/<tag>/ made by zdxsv-release.sh;
#                            root-owned, so the service cannot replace its own binary
#   /etc/zdxsv/zdxsv.env     the environment, root:zdxsv 640
#   /var/lib/zdxsv           the database (ZDXSV_DB_NAME=/var/lib/zdxsv/zdxsv.db), the only
#                            place the service can write
# Files the environment names (TLS keys, credentials, the relay start command) must be
# outside /home, which the service cannot see.
[Unit]
Description=zdxsv - Gundam vs Zeta Gundam private game server
After=network-online.target
Wants=network-online.target

[Service]
User=zdxsv
Group=zdxsv
StateDirectory=zdxsv
StateDirectoryMode=0750
WorkingDirectory=/var/lib/zdxsv
EnvironmentFile=/etc/zdxsv/zdxsv.env
ExecStart=/opt/zdxsv/bin/zdxsv
Restart=always
RestartSec=5
# Ports 53 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536
# glog writes to stderr (main.go sets logtostderr); journald keeps it.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
